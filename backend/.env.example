# Copy this file to .env and fill in your own values. NEVER commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/stockpilot for local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockpilot?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Comma separated list of allowed web origins (CORS)
CLIENT_URL=http://localhost:5173

# Used to group sales by day on the dashboard/reports
TIMEZONE=Asia/Kolkata
